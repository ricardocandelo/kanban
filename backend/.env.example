# ============================================================
# FLOWBOARD BACKEND - VARIABLES DE ENTORNO (VERCEL & LOCAL)
# ============================================================

# Entorno de ejecución
NODE_ENV=production
PORT=5000

# URL del Frontend (configura tu dominio de Vercel del Frontend)
# Ejemplo: https://flowboard-frontend.vercel.app
FRONTEND_URL=https://tu-frontend.vercel.app

# ============================================================
# BASE DE DATOS (Neon PostgreSQL)
# ============================================================
# IMPORTANTE en Vercel Serverless: Usar el endpoint 'pooler' con sslmode=require
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Conexión directa a Neon (usada por Prisma CLI / migraciones)
DIRECT_URL="postgresql://usuario:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# SEGURIDAD & AUTENTICACIÓN (JWT)
# ============================================================
# Genera contraseñas secretas seguras y aleatorias en producción
JWT_ACCESS_SECRET="coloca_aqui_una_clave_secreta_fuerte_de_al_menos_32_caracteres"
JWT_REFRESH_SECRET="coloca_aqui_otra_clave_secreta_fuerte_diferente"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================================
# CLOUDINARY (Almacenamiento de Avatares y Adjuntos)
# ============================================================
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"
